# Rattel Ayah Academy — environment reference
#
# This is a static HTML/CSS/JS site (no build step), so these values
# aren't read automatically by Vercel at runtime — you copy them into
# assets/supabase-config.js directly (see README.md, "Configure environment").
#
# They're listed here so the values are documented in one place and
# easy to find if you ever add a build step.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Never put your Supabase service_role key in this project, in
# assets/supabase-config.js, or in any frontend file.
